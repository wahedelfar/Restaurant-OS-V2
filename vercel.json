{
  "version": 2,
  "cleanUrls": true,
  "alias": ["ros-v10.vercel.app"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/kds", "destination": "/public/kds/index.html" },
    { "source": "/kds/", "destination": "/public/kds/index.html" }
  ]
}
